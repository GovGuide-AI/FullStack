# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never committed, but the template must be
.env*
!.env.example
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# knowledge pipeline — fetched source text and the retrieval index are
# reproducible from knowledge/sources.json via `npm run ingest`. Evidence
# bundles under knowledge/drafts/ are regenerated per drafting session.
/knowledge/.index/
/knowledge/drafts/

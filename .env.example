# Copy to .env.local for development. Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Database (optional)
# ---------------------------------------------------------------------------
# Leave unset and the app still answers questions — it just cannot remember
# sessions or saved checklists. Guidance matters more than persistence.
#
# Local Postgres in one command:
#   docker run -d --name govguide-pg -e POSTGRES_PASSWORD=devpass \
#     -e POSTGRES_USER=govguide -e POSTGRES_DB=govguide -p 5432:5432 postgres:17-alpine
DATABASE_URL=postgres://govguide:devpass@localhost:5432/govguide

# ---------------------------------------------------------------------------
# OpenRouter (required)
# ---------------------------------------------------------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Three model roles, deliberately configuration rather than code so a model can
# be swapped without a redeploy.
#
# IMPORTANT: model IDs are released and retired constantly. Confirm any value
# against the live list before using it:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id'
#
# The values below were verified against that endpoint on 2026-07-25, filtered
# to models advertising `structured_outputs` support, which this app requires.
# They are a starting point, not a recommendation — evaluate Amharic quality
# before choosing a production model.

# Classifies a question into one catalog slug. Small and fast is right here.
OPENROUTER_ROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free

# Writes the short explanation around the retrieved record.
OPENROUTER_ANSWER_MODEL=google/gemma-4-26b-a4b-it:free

# Optional. Falls back to the answer model when unset.
OPENROUTER_SUMMARY_MODEL=openai/gpt-oss-20b:free

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Optional. Sent to OpenRouter for dashboard attribution.
APP_URL=http://localhost:3000
